# Copy to .env and edit. Works out of the box with SQLite.

# --- Database ---
# Local (default): SQLite file under backend/data/
DATABASE_URL=sqlite:///./data/users.db
# Team Neon (shared.users / shared.learners) — set in .env only, never commit secrets:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/neondb?sslmode=require
# PostgreSQL local:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/scipath_users

# --- JWT (use a long random secret in production) ---
JWT_SECRET=dev-change-me-user-management-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360
PASSWORD_RESET_EXPIRE_MINUTES=60
# true = forgot-password response includes reset_token (local testing only). Default false.
EXPOSE_RESET_TOKEN=true

# --- CORS (frontends allowed to call this API) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Google OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback
# OAUTH_SUCCESS_REDIRECT=http://127.0.0.1:3001/auth/callback
